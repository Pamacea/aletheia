{
  "name": "aletheia",
  "version": "0.2.6",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('node_modules/.cache',{recursive:true,force:true});\"",
    "dev": "npm run clean && next dev",
    "dev:no-clean": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\"",
    "clean:logs": "rm -f *.log",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:philosophers": "tsx prisma/philosophers-seed.ts",
    "db:seed:achievements": "tsx prisma/seed-achievements.ts",
    "db:seed:movements": "tsx prisma/seed/movements-seed.ts",
    "db:seed:obsidian": "tsx prisma/obsidian-seed.ts",
    "db:seed:comprehensive": "tsx prisma/seed/comprehensive-seed.ts",
    "db:reset": "prisma migrate reset",
    "db:seed:force": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:seed:movements:force": "prisma migrate reset --force && tsx prisma/seed/movements-seed.ts",
    "db:seed:obsidian:force": "prisma migrate reset --force && tsx prisma/obsidian-seed.ts",
    "db:seed:comprehensive:force": "prisma migrate reset --force && tsx prisma/seed/comprehensive-seed.ts",
    "db:seed:forum": "tsx prisma/forum-seed.ts",
    "db:seed:concept-relations": "tsx prisma/seed/concept-relations.ts",
    "db:seed:concept-relations:stats": "tsx prisma/seed/concept-relations.ts",
    "db:seed:concept-relations:clear": "tsx prisma/seed/concept-relations.ts --clear",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "@xyflow/react": "^12.10.1",
    "better-auth": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.30.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.1.6",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "reactflow": "^11.11.4",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "^1.0.30001774",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "happy-dom": "^20.7.0",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "prisma": "^7.4.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}
